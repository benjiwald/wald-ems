# ──────────────────────────────────────────────────
# Wald EMS Configuration
# Copy to wald-ems.yaml and adjust to your setup
# ──────────────────────────────────────────────────

site:
  name: "Mein Zuhause"
  grid_limit_kw: 11          # Netzanschlussleistung in kW
  buffer_w: 100              # Sicherheitspuffer in Watt
  priority_soc: 20           # Batterie-Vorrang bis SoC% (0 = aus). 20 schuetzt
                             # die Hausbatterie davor, waehrend Wolken-Puffer
                             # leergezogen zu werden. battery_redirect (Auto-vor-
                             # Batterie) greift erst ab diesem SoC.
  grid_price_eur_kwh: 0.27   # Strombezugspreis
  feedin_price_eur_kwh: 0.065 # Einspeiseverguetung

# ── Messgeraete / Wechselrichter ──
meters:
  - name: "Victron System"
    type: victron_venus_system
    host: 192.168.1.70
    port: 502
    unit_id: 100

# ── Ladestationen ──
chargers:
  - name: "Wallbox"
    type: nrgkick_modbus
    host: 192.168.1.84
    port: 502
    unit_id: 1

# ── Ladepunkte ──
loadpoints:
  - name: "Garage"
    charger: "Wallbox"       # Referenz auf charger.name
    mode: pv                 # off | now | pv | min_pv
    min_current: 9           # Ampere. Renault Zoe: MIND. 9A — unter ~8.5A faellt
                             # der Power Factor in den Keller (Zombie-Mode).
    max_current: 16          # Ampere
    phases: 3                # Zoe: IMMER 3-phasig, NIE umschalten (killt Session)
    target_soc: 90           # Laden bis hier (braucht Vehicle mit battery_kwh)
    min_soc: 20              # Erzwingt Laden unter diesem SoC
    # session_limit_factor: 0.95  # Safety-Cap: max 95% der battery_kwh pro Session
    #                              # (greift falls SoC-Estimation/Cloud-API ausfaellt)
    # zombie_wakeup_enabled: false # CP-Toggle nach Stillstand. Bei Renault AUTOMATISCH
    #                              # aus (Zoe verliert sonst Session). Nur fuer
    #                              # andere EVs sinnvoll.

# ── Fahrzeuge (optional) ──
# Mit Vehicle-Eintrag: SoC-basiertes Laden bis target_soc + Session-Estimation
# (robust gegen Renault-Cloud-Lag). Ohne: reines PV-Ueberschuss-Laden.
vehicles: []
  # - name: "Renault Zoe"
  #   manufacturer: renault
  #   loadpoint: "Garage"      # muss zum loadpoint.name passen
  #   vin: "VF1..."
  #   battery_kwh: 40          # Zoe R110/R135: 40 kWh (noetig fuer SoC-Estimation)
  #   credentials:
  #     email: "user@example.com"
  #     password: "secret"

# ── PV-Prognose (optional) ──
# forecast:
#   lat: 47.07
#   lon: 15.44
#   planes:
#     - name: "Dach Sued"
#       kwp: 5.0
#       declination: 30
#       azimuth: 0

# ── Dynamischer Tarif (optional) ──
# tariff:
#   provider: awattar
#   country: at
#   markup_ct: 3.0

# ── Datenbank ──
database:
  path: ./wald-ems.db
  retention_days: 30
